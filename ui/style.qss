QMainWindow {
    background-color: #f4f6fb;
}

QMenuBar {
    background-color: #2c3e50;
    color: white;
    padding: 4px;
    font-size: 14px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    margin: 2px;
}

QMenuBar::item:selected {
    background-color: #34495e;
    border-radius: 4px;
}

QMenu {
    background-color: white;
    color: #2c3e50;
    border: 1px solid #dcdcdc;
}

QMenu::item:selected {
    background-color: #e8f0fe;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1f5f8b;
}

QLineEdit {
    background-color: white;
    border: 1px solid #cfd8e3;
    border-radius: 6px;
    padding: 8px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #3498db;
}

QCheckBox {
    font-size: 14px;
    color: #2c3e50;
    spacing: 8px;
}

QLabel {
    color: #2c3e50;
    font-size: 14px;
}

QFrame#Sidebar {
    background-color: #2c3e50;
    border-radius: 0px;
}

QFrame#ContentArea {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

QPushButton#SideButton {
    background-color: #34495e;
    color: white;
    border: none;
    padding: 14px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: bold;
    text-align: left;
}

QPushButton#SideButton:hover {
    background-color: #3f5870;
    text-decoration: underline;
}

QPushButton#SideButton:checked {
    background-color: #1abc9c;
    text-decoration: underline;
}


QLabel#TitleLabel {
    font-size: 20px;
    font-weight: bold;
    color: #2c3e50;
}

QLabel#SubtitleLabel {
    color: #6b7280;
    font-size: 13px;
}

QLabel#SidebarTitle {
    color: white;
    font-size: 18px;
    font-weight: bold;
}

QLabel#PlaceholderLabel {
    font-size: 16px;
    color: #7f8c8d;
}
