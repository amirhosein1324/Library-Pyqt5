/* ===== Form Styles ===== */

#form {
    background-color: #17191f;
}

#form QLabel {
    color: #b7bcc6;
    padding-top: 10px;
    font-size: 10pt;
}

#form QLineEdit {
    background-color: #20242c;
    border: 1px solid #2e333e;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    color: #ffffff;
    selection-background-color: #16c98d;
    selection-color: #0e1512;
}

#form QLineEdit:focus {
    border: 1px solid #16c98d;
}

#form QLineEdit:read-only {
    color: #8b93a3;
    background-color: #1a1d24;
}

#form QPushButton {
    background-color: #16c98d;
    color: #0e1512;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
}

#form QPushButton:hover {
    background-color: #22e39f;
}

#form QPushButton:pressed {
    background-color: #10a877;
}

#form QComboBox {
    background-color: #20242c;
    border: 1px solid #2e333e;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    color: #ffffff;
}

#form QComboBox:focus {
    border: 1px solid #16c98d;
}

#form QListWidget {
    background-color: #20242c;
    border: 1px solid #2e333e;
    border-radius: 8px;
    padding: 4px;
    font-size: 13px;
    color: #ffffff;
}

#form QListWidget::item:selected {
    background-color: #16c98d;
    color: #0e1512;
}

#title {
    background-color: #16c98d;
    border-radius: 8px;
    font-size: 11pt;
    font-weight: 700;
    padding: 12px 16px;
    color: #0e1512;
}

#formHeader {
    background-color: #1c2129;
    border-bottom: 1px solid #262b34;
    color: #ffffff;
    font-size: 13pt;
    font-weight: 700;
    padding: 18px 24px;
}

#formContent {
    background-color: #17191f;
}

#sectionLabel {
    color: #16c98d;
    font-size: 9pt;
    font-weight: 700;
    padding-top: 4px;
}

#divider {
    background-color: #262b34;
    border: none;
    max-height: 1px;
}

#fieldLabel {
    color: #8b93a3;
    padding-top: 0px;
    font-size: 9pt;
    font-weight: 600;
}

#formFooter {
    background-color: #1c2129;
    border-top: 1px solid #262b34;
}

#form QPushButton#btnPrimary {
    background-color: #16c98d;
    color: #0e1512;
    min-width: 120px;
}

#form QPushButton#btnPrimary:hover {
    background-color: #22e39f;
}

#form QPushButton#btnPrimary:pressed {
    background-color: #10a877;
}

#form QPushButton#btnSecondary {
    background-color: transparent;
    color: #b7bcc6;
    border: 1px solid #343a46;
    min-width: 90px;
}

#form QPushButton#btnSecondary:hover {
    background-color: #232730;
    color: #ffffff;
}

#form QPushButton#btnSecondary:pressed {
    background-color: #1a1d24;
}